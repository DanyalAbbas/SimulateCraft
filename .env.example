# Prefer OpenRouter, 9Router, or your own OpenAI-compatible API.
# Groq works for a quick try but rate-limits quickly.

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 9Router / own API (OpenAI-compatible)
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=
# SIMULATECRAFT_MODEL=oc/mimo-v2.5-free

# Optional Groq (rate-limited): https://console.groq.com/keys
# GROQ_API_KEY=

# Optional model override
# SIMULATECRAFT_MODEL=
